{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://igmc.local/schemas/issue.schema.json",
  "title": "IGMC Issue Object",
  "type": "object",
  "required": ["schema_version", "title", "type", "area", "status", "summary", "acceptance_criteria", "validation"],
  "properties": {
    "schema_version": { "type": "string" },
    "title": { "type": "string" },
    "type": { "type": "string" },
    "area": { "type": "string" },
    "status": { "type": "string" },
    "summary": { "type": "string" },
    "motivation": { "type": "string" },
    "scope": { "type": "object" },
    "acceptance_criteria": { "type": "array" },
    "validation": { "type": "array" },
    "source_references": { "type": "array" },
    "dependencies": { "type": "array" },
    "risks": { "type": "array" },
    "implementation_notes": { "type": "array" }
  }
}