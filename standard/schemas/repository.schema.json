{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://igmc.local/schemas/repository.schema.json",
  "title": "IGMC Repository Contract",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "standard",
    "paths",
    "commands",
    "issues",
    "agents",
    "alignment",
    "exemptions"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "repository": {
      "type": "object",
      "required": ["id", "name", "archetype", "lifecycle", "visibility"]
    },
    "standard": {
      "type": "object",
      "required": ["profile", "version", "automatic_checks"]
    },
    "paths": { "type": "object" },
    "commands": { "type": "object" },
    "issues": { "type": "object" },
    "agents": { "type": "object" },
    "alignment": { "type": "object" },
    "exemptions": { "type": "array" }
  }
}